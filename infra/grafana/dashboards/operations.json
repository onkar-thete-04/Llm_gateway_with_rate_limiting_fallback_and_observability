{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "uid": "llm-gateway-operations",
  "title": "LLM Gateway - Operations",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(llm_gateway_requests_total, team)", "refId": "team" },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(llm_gateway_requests_total, provider)", "refId": "provider" },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Provider status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "llm_gateway_provider_status{provider=~\"$provider\"}", "refId": "A", "legendFormat": "{{provider}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Healthy", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "Degraded", "color": "orange" } } },
            { "type": "value", "options": { "2": { "text": "Down", "color": "red" } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Circuit breaker state",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "expr": "llm_gateway_circuit_breaker_state{provider=~\"$provider\"}", "refId": "A", "legendFormat": "{{provider}}" }
      ],
      "fieldConfig": { "defaults": { "custom": {} }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Circuit transitions",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "sum(rate(llm_gateway_circuit_breaker_transitions_total[$__rate_interval])) by (provider)", "refId": "A", "legendFormat": "{{provider}}" }
      ],
      "fieldConfig": { "defaults": { "custom": {} }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum(rate(llm_gateway_request_errors_total[$__rate_interval])) by (provider, error_type)", "refId": "A", "legendFormat": "{{provider}} {{error_type}}" }
      ],
      "fieldConfig": { "defaults": { "custom": {} }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Fallback events",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "sum(rate(llm_gateway_fallbacks_total[$__rate_interval])) by (team, provider)", "refId": "A", "legendFormat": "{{team}} -> {{provider}}" }
      ],
      "fieldConfig": { "defaults": { "custom": {} }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum(rate(llm_gateway_requests_total[$__rate_interval])) by (status)", "refId": "A", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "custom": {} }, "overrides": [] }
    }
  ]
}
